---
/**
 * "What does this print?" multiple-choice question.
 * Every option carries its own explanation, shown when the student picks it,
 * so wrong answers teach why the misconception fails.
 */
import { Code } from '@astrojs/starlight/components';

interface Option {
  text: string;
  explanation: string;
  correct?: boolean;
}

interface Props {
  code: string;
  options: Option[];
  question?: string;
}

const { code, options, question = '¿Qué imprime este código?' } = Astro.props;
---

<div class="quiz not-content">
  <p class="quiz-question">{question}</p>
  <Code code={code.trim()} lang="py" />
  <div class="quiz-options" role="group" aria-label="Alternativas">
    {options.map((opt, i) => (
      <button type="button" class="quiz-option" data-index={i} data-correct={opt.correct ? 'true' : 'false'}>
        <span class="quiz-letter">{String.fromCharCode(65 + i)}</span>
        <span class="quiz-text">{opt.text}</span>
      </button>
    ))}
  </div>
  <div class="quiz-feedback" aria-live="polite">
    {options.map((opt, i) => (
      <p class="quiz-explanation" data-index={i} hidden>
        <strong>{opt.correct ? '✅ ¡Correcto!' : '❌ No.'}</strong> {opt.explanation}
      </p>
    ))}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.quiz').forEach((quiz) => {
    const buttons = quiz.querySelectorAll<HTMLButtonElement>('.quiz-option');
    const explanations = quiz.querySelectorAll<HTMLElement>('.quiz-explanation');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const index = btn.dataset.index;
        btn.classList.add(btn.dataset.correct === 'true' ? 'is-correct' : 'is-wrong');
        buttons.forEach((b) => b.classList.toggle('is-selected', b === btn));
        explanations.forEach((e) => (e.hidden = e.dataset.index !== index));
      });
    });
  });
</script>

<style>
  .quiz {
    margin: 1.5rem 0;
    padding: 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--sl-color-gray-6);
  }
  .quiz-question {
    margin: 0 0 0.75rem;
    font-weight: 600;
  }
  .quiz-options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .quiz-option {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    text-align: left;
    padding: 0.6rem 0.75rem;
    border: 2px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    cursor: pointer;
    font: inherit;
  }
  .quiz-option:hover {
    border-color: var(--sl-color-accent);
  }
  .quiz-letter {
    flex: none;
    font-weight: 700;
    color: var(--sl-color-text-accent);
  }
  .quiz-text {
    font-family: var(--sl-font-mono);
    font-size: 0.9rem;
    white-space: pre-line;
  }
  .quiz-option.is-wrong {
    border-color: var(--sl-color-red);
    background: var(--sl-color-red-low);
  }
  .quiz-option.is-correct {
    border-color: var(--sl-color-green);
    background: var(--sl-color-green-low);
  }
  .quiz-option.is-selected {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }
  .quiz-explanation {
    margin: 0.75rem 0 0;
    padding: 0.6rem 0.75rem;
    border-radius: 0.375rem;
    background: var(--sl-color-gray-5);
    font-size: 0.9rem;
  }
</style>
